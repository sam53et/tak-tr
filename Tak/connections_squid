#!/bin/bash

inst_sqd() {
	if netstat -nltp | grep 'squid' 1>/dev/null 2>/dev/null; then
		banner_danger "            SQUID PROXY'Yİ KALDIR              "
		echo ""
		color_echo_n "SQUID'İ GERÇEKTEN KALDIRMAK İSTİYOR MUSUNUZ " "green"
		color_echo_n "? " "red"
		color_echo_n "[e/h]: " "yellow"
		read resp
		[[ "$resp" =~ ^[eEyY]$ ]] && {
			echo ""
			color_echo "SQUID PROXY KALDIRILIYOR !" "green"
			echo ""
			rem_sqd() {
				local ports_to_close=""
				[[ -f "/etc/squid/squid.conf" ]] && ports_to_close=$(grep '^http_port' /etc/squid/squid.conf | awk '{print $2}')
				[[ -f "/etc/squid3/squid.conf" ]] && ports_to_close="$ports_to_close $(grep '^http_port' /etc/squid3/squid.conf | awk '{print $2}')"
				[[ -d "/etc/squid" ]] && {
					apt-get remove squid -y >/dev/null 2>&1
					apt-get purge squid -y >/dev/null 2>&1
					rm -rf /etc/squid >/dev/null 2>&1
				}
				[[ -d "/etc/squid3" ]] && {
					apt-get remove squid3 -y >/dev/null 2>&1
					apt-get purge squid3 -y >/dev/null 2>&1
					rm -rf /etc/squid3 >/dev/null 2>&1
				}
				rm -rf /var/log/squid >/dev/null 2>&1
				rm -rf /var/spool/squid >/dev/null 2>&1
				rm -rf /var/spool/squid3 >/dev/null 2>&1
				apt-get autoremove -y >/dev/null 2>&1
			}
			fun_bar 'rem_sqd'
			echo ""
			msg_ok "SQUID BAŞARIYLA KALDIRILDI !"
			sleep 2
			clear
			fun_connections
		} || {
			echo ""
			msg_err "Geri dönülüyor..."
			sleep 2
			clear
			fun_connections
		}
	else
		clear
		banner_info "              SQUID KURULUMU                "
		echo ""
		if [[ -f /etc/IP ]] && [[ -s /etc/IP ]]; then
			IP=$(tr -d '\r\n' < /etc/IP)
		else
			IP=$(curl -4 -sfL --max-time 5 https://ipv4.icanhazip.com 2>/dev/null | tr -d '\r\n')
			[[ -z "$IP" ]] && IP=$(curl -4 -sfL --max-time 5 https://api.ipify.org 2>/dev/null | tr -d '\r\n')
			[[ -z "$IP" ]] && IP=$(wget -qO- --timeout=5 https://ipv4.icanhazip.com 2>/dev/null | tr -d '\r\n')
			[[ -z "$IP" ]] && IP=$(hostname -I 2>/dev/null | awk '{print $1}')
			[[ -n "$IP" ]] && echo "$IP" > /etc/IP 2>/dev/null
		fi
		[[ -z "$IP" ]] && IP=""
		echo -ne "\033[1;32mDEVAM ETMEK İÇİN IP'NİZİ ONAYLAYIN: \033[1;37m"
		read -e -i "$IP" ipdovps
		ipdovps="${ipdovps//[[:space:]]/}"
		[[ -z "$ipdovps" ]] && {
			echo ""
			msg_err "Geçersiz IP"
			echo ""
			read -p "IP adresinizi girin: " ipdovps
			ipdovps="${ipdovps//[[:space:]]/}"
		}
		[[ -n "$ipdovps" ]] && echo "$ipdovps" > /etc/IP 2>/dev/null
		echo ""
		color_echo_n "SQUID'DE HANGİ PORTLARI KULLANMAK İSTİYORSUNUZ " "yellow"
		color_echo "?" "red"
		echo ""
		msg_warn "[!] PORTLARI SIRAYLA GİRİN ÖRN: 80 8080 8799"
		echo ""
		color_echo_n "PORTLARI GİRİN: " "green"
		read portass
		[[ -z "$portass" ]] && {
			echo ""
			msg_err "Geçersiz port!"
			sleep 3
			fun_connections
		}
		for porta in $(echo -e $portass); do
			verif_ptrs $porta
		done
		echo ""
		color_echo "SQUID PROXY KURULUYOR" "green"
		echo ""
		fun_bar 'apt-get update -y' 'apt-get install squid -y'
		if [[ -d "/etc/squid/" ]]; then
			var_sqd="/etc/squid/squid.conf"
			var_pay="/etc/squid/payload.txt"
		elif [[ -d "/etc/squid3/" ]]; then
			var_sqd="/etc/squid3/squid.conf"
			var_pay="/etc/squid3/payload.txt"
		else
			echo ""
			msg_err "HATA! SQUID PROXY BOZULMUŞ"
			sleep 2
			fun_connections
		fi
		cat <<-EOF >$var_pay
			.claro.com.br/
			.claro.com.sv/
			.facebook.net/
			.netclaro.com.br/
			.speedtest.net/
			.tim.com.br/
			.vivo.com.br/
			.oi.com.br/
		EOF
		cat <<-EOF >$var_sqd
			acl url1 dstdomain 127.0.0.1
			acl url2 dstdomain localhost
			acl url3 dstdomain $ipdovps
			acl url4 dstdomain /SSHPLUS?
			acl payload url_regex -i "$var_pay"
			acl all src 0.0.0.0/0

			http_access allow url1
			http_access allow url2
			http_access allow url3
			http_access allow url4
			http_access allow payload
			http_access deny all

		EOF
		for Pts in $(echo -e $portass); do
			echo -e "http_port $Pts" >>$var_sqd
		done
		cat <<-EOF >>$var_sqd
			visible_hostname vpnunderground.com
			via off
			forwarded_for off
			pipeline_prefetch off
		EOF
		sqd_conf() {
			[[ -d "/etc/squid/" ]] && {
				service ssh restart
				/etc/init.d/squid start
				service squid restart
			}
			[[ -d "/etc/squid3/" ]] && {
				service ssh restart
				/etc/init.d/squid3 start
				service squid3 restart
			}
		}
		echo ""
		color_echo "SQUID PROXY YAPILANDIRILIYOR" "green"
		echo ""
		fun_bar 'sqd_conf'
		echo ""
		msg_ok "SQUID BAŞARIYLA KURULDU!"
		sleep 2.5s
		fun_connections
	fi
}

addpt_sqd() {
	banner_info "         SQUID'E PORT EKLE         "
	echo -e "\n\033[1;33mKULLANIMDAKİ PORTLAR: \033[1;32m$sqdp\n"
	if [[ -f "/etc/squid/squid.conf" ]]; then
		var_sqd="/etc/squid/squid.conf"
	elif [[ -f "/etc/squid3/squid.conf" ]]; then
		var_sqd="/etc/squid3/squid.conf"
	else
		echo -e "\n\033[1;31mSQUID KURULU DEĞİL!\033[0m"
		echo -e "\n\033[1;31mGeri dönülüyor...\033[0m"
		sleep 2
		clear
		fun_squid
	fi
	echo -ne "\033[1;32mHANGİ PORTU EKLEMEK İSTİYORSUNUZ \033[1;33m?\033[1;37m "
	read pt
	[[ -z "$pt" ]] && {
		echo ""
		msg_err "Geçersiz port!"
		sleep 2
		clear
		fun_connections
	}
	verif_ptrs $pt
	echo ""
	color_echo "SQUID'E PORT EKLENİYOR!" "green"
	echo ""
	sed -i "s/#Portas/#Portas\nhttp_port $pt/g" $var_sqd
	fun_bar 'sleep 2'
	echo ""
	color_echo "SQUID YENİDEN BAŞLATILIYOR!" "green"
	echo ""
	fun_bar 'service squid restart' 'service squid3 restart'
	echo ""
	msg_ok "PORT BAŞARIYLA EKLENDİ!"
	sleep 3
	clear
	fun_squid
}

rempt_sqd() {
	banner_danger "        SQUID PORTUNU KALDIR        "
	echo -e "\n\033[1;33mKULLANIMDAKİ PORTLAR: \033[1;32m$sqdp\n"
	if [[ -f "/etc/squid/squid.conf" ]]; then
		var_sqd="/etc/squid/squid.conf"
	elif [[ -f "/etc/squid3/squid.conf" ]]; then
		var_sqd="/etc/squid3/squid.conf"
	else
		echo -e "\n\033[1;31mSQUID KURULU DEĞİL!\033[0m"
		echo -e "\n\033[1;31mGeri dönülüyor...\033[0m"
		sleep 2
		clear
		fun_squid
	fi
	color_echo_n "HANGİ PORTU KALDIRMAK İSTİYORSUNUZ " "green"
	color_echo_n "?" "yellow"
	color_echo_n " " "white"
	read pt
	[[ -z "$pt" ]] && {
		echo ""
		msg_err "Geçersiz port!"
		sleep 2
		clear
		fun_connections
	}
	if grep -E "$pt" $var_sqd >/dev/null 2>&1; then
		echo ""
		color_echo "SQUID PORTU KALDIRILIYOR!" "green"
		echo ""
		sed -i "/http_port $pt/d" $var_sqd
		fun_bar 'sleep 3'
		echo ""
	color_echo "SQUID YENİDEN BAŞLATILIYOR!" "green"
		echo ""
		fun_bar 'service squid restart' 'service squid3 restart'
		echo ""
		msg_ok "PORT BAŞARIYLA KALDIRILDI!"
		sleep 3.5s
		clear
		fun_squid
	else
		echo ""
		color_echo_n "PORT " "red"
		color_echo_n "$pt " "green"
		color_echo "BULUNAMADI!" "red"
		sleep 3.5s
		clear
		fun_squid
	fi
}

fun_squid() {
	[[ "$(netstat -nplt | grep -c 'squid')" = "0" ]] && inst_sqd
	banner_info "          SQUID PROXY YÖNETİMİ           "
	[[ "$(netstat -nplt | grep -c 'squid')" != "0" ]] && {
		sqdp=$(netstat -nplt | grep 'squid' | awk '{print $4}' | sed 's/.*://' | xargs)
		echo -e "\n\033[1;33mPORTLAR\033[1;37m: \033[1;32m$sqdp"
		VarSqdOn="SQUID PROXY'Yİ KALDIR"
	} || {
		VarSqdOn="SQUID PROXY KUR"
	}
	echo ""
	menu_option "1" "$VarSqdOn" "red" "yellow"
	menu_option "2" "PORT EKLE" "red" "yellow"
	menu_option "3" "PORTU KALDIR" "red" "yellow"
	menu_option "0" "GERİ" "red" "yellow"
	echo ""
	color_echo_n "LÜTFEN SEÇENEKLERDEN BİRİNİ SEÇİN " "green"
	color_echo_n "" "yellow"
	color_echo_n "" "red"
	color_echo_n "" "white"
	read x
	clear
	case $x in
	1 | 01)
		inst_sqd
		;;
	2 | 02)
		addpt_sqd
		;;
	3 | 03)
		rempt_sqd
		;;
	0 | 00)
		echo -e "\033[1;31mGeri dönülüyor...\033[0m"
		sleep 1
		fun_connections
		;;
	*)
		msg_err "Geçersiz Seçenek..."
		sleep 2
		fun_connections
		;;
	esac
}

