#!/bin/bash

_REPO_URL="https://raw.githubusercontent.com/sam53et/tak-tr/main"

_lvk=$(wget -qO- --timeout=5 "$_REPO_URL/version" 2>/dev/null)
[[ -z "$_lvk" ]] && _lvk=$(curl -sfL --max-time 5 "$_REPO_URL/version" 2>/dev/null)
IP=$(wget -qO- --timeout=5 https://ipv4.icanhazip.com 2>/dev/null)
[[ -z "$IP" ]] && IP=$(curl -sfL --max-time 5 https://ipv4.icanhazip.com 2>/dev/null)
IP2=$(wget -qO- --timeout=5 http://whatismyip.akamai.com/ 2>/dev/null)
[[ -z "$IP2" ]] && IP2=$(curl -sfL --max-time 5 http://whatismyip.akamai.com/ 2>/dev/null)
[[ -n "$IP" ]] || [[ -n "$IP2" ]] && { [[ "$IP" != "$IP2" ]] && ipdovps="${IP2:-$IP}" || ipdovps="${IP:-$IP2}"; echo "$ipdovps" >/etc/IP; }
lst=$1 && lst1=$2 && lst2=$3 && key1=$4 && key2=crz
[[ -z "$lst1" ]] && {
	exit 0
}
[[ ! -d /etc/SSHPlus ]] && mkdir /etc/SSHPlus
[[ ! -d /etc/SSHPlus/userteste ]] && mkdir /etc/SSHPlus/userteste
[[ ! -d /etc/SSHPlus/.tmp ]] && mkdir /etc/SSHPlus/.tmp
echo -e 'by: @CRAZY_VPN' >/usr/lib/sshplus && cat /usr/lib/sshplus >$lst2/licence && cat /usr/lib/sshplus > /etc/SSHPlus/.tmp/crazy
[[ "$(grep -o '#Port 22' /etc/ssh/sshd_config)" == "#Port 22" ]] && sed -i "s;#Port 22;Port 22;" /etc/ssh/sshd_config && service ssh restart
grep -v "^PasswordAuthentication" /etc/ssh/sshd_config >/tmp/passlogin && mv /tmp/passlogin /etc/ssh/sshd_config
echo "PasswordAuthentication yes" >>/etc/ssh/sshd_config
_dir1='/bin'
_dir2='/etc/SSHPlus'
_dir_tak='/etc/SSHPlus/Tak'
rm $_dir2/cabecalho $_dir2/proxy.py $_dir2/colors $_dir2/db >/dev/null 2>&1
rm -rf $_dir_tak >/dev/null 2>&1
mkdir -p $_dir_tak >/dev/null 2>&1

_mdls=("changepassword" "createuser" "expiredusers" "changeexpiration" "expirationmanager" "removeuser" "changelimit" "sshmonitor" "userbackup" "menu" "hizlitest" "bannersetup" "serversettings" "restartservices" "rebootsystem" "connections" "removescript" "vpsinfo" "userinfo" "proxy.py" "colors" "db" "multiport" "vpstraffic" "autorun" "sessionlogger" "connlimiter")
for _arq in ${_mdls[@]}; do
	[[ -e $_dir1/$_arq ]] && rm $_dir1/$_arq >/dev/null 2>&1
	_download_url="$_REPO_URL/Modules/$_arq"
	if ! wget -c -P $_dir1 "$_download_url" >/dev/null 2>&1; then
		if ! curl -sL "$_download_url" -o "$_dir1/$_arq" >/dev/null 2>&1; then
			echo "HATA: $_arq dosyası $_download_url adresinden indirilemedi" >&2
			continue
		fi
	fi
	if [[ -f "$_dir1/$_arq" ]] && [[ -s "$_dir1/$_arq" ]]; then
		chmod +x "$_dir1/$_arq"
	else
		echo "HATA: $_arq indirilemedi veya $_dir1/$_arq dosyası boş" >&2
	fi
done
mv $_dir1/proxy.py $_dir1/colors $_dir1/db $_dir2 >/dev/null 2>&1

_tak_mdls=("connections_common" "connections_squid" "connections_dropbear" "connections_stunnel" "connections_socks" "connections_openssh" "connections_sslh" "connections_udpgw" "connections_kapat")
for _arq in ${_tak_mdls[@]}; do
	_download_url="$_REPO_URL/Tak/$_arq"
	if ! wget -q -O "$_dir_tak/$_arq" "$_download_url" >/dev/null 2>&1; then
		if ! curl -sL "$_download_url" -o "$_dir_tak/$_arq" >/dev/null 2>&1; then
			echo "HATA: Tak/$_arq dosyası $_download_url adresinden indirilemedi" >&2
			continue
		fi
	fi
	if [[ -f "$_dir_tak/$_arq" ]] && [[ -s "$_dir_tak/$_arq" ]]; then
		chmod +x "$_dir_tak/$_arq"
	else
		echo "HATA: Tak/$_arq indirilemedi veya boş" >&2
	fi
done
screen -wipe >/dev/null 2>&1
printf '#!/bin/bash\nclear\n' >/etc/autostart
chmod +x /etc/autostart
(
	crontab -l 2>/dev/null | grep -v '/etc/autostart'
	echo "@reboot /etc/autostart"
) | crontab -
echo "$_lvk" | head -1 | tr -d '\r\n' >/bin/version
[[ -s /bin/version ]] && cp /bin/version /home/sshplus 2>/dev/null
if ! command -v jq >/dev/null 2>&1; then
	apt-get install -y jq >/dev/null 2>&1 || true
fi

if [[ ! -f /bin/menu ]] || [[ ! -x /bin/menu ]]; then
	echo "HATA: Menu komutu düzgün kurulmadı!" >&2
	echo "$_REPO_URL/Modules/menu adresinden menu yeniden indiriliyor..." >&2
	if wget -q "$_REPO_URL/Modules/menu" -O /bin/menu 2>&1 || curl -sL "$_REPO_URL/Modules/menu" -o /bin/menu 2>&1; then
		if [[ -f /bin/menu ]] && [[ -s /bin/menu ]]; then
			chmod +x /bin/menu
			echo "Menu başarıyla yeniden indirildi!" >&2
		else
			echo "HATA: Menu dosyası boş veya geçersiz!" >&2
		fi
	else
		echo "HATA: Menu dosyası indirilemedi!" >&2
	fi
fi

service cron restart >/dev/null 2>&1
service ssh restart >/dev/null 2>&1

if [[ -x /bin/sessionlogger ]]; then
	/bin/sessionlogger stop >/dev/null 2>&1 || true
	/bin/sessionlogger start >/dev/null 2>&1 || true
fi
(crontab -l 2>/dev/null | grep -v sessionlogger; echo "@reboot /bin/sessionlogger start") | crontab - 2>/dev/null || true

if [[ -x /bin/connlimiter ]]; then
	/bin/connlimiter stop >/dev/null 2>&1 || true
	/bin/connlimiter start >/dev/null 2>&1 || true
fi
(crontab -l 2>/dev/null | grep -v connlimiter; echo "@reboot /bin/connlimiter start") | crontab - 2>/dev/null || true
rm -rf $lst1/list >/dev/null 2>&1
